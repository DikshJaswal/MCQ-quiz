# Copy this file to ".env" and fill it in. NEVER commit ".env" to Git.
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g()+g())"
DJANGO_SECRET_KEY=

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# True = local development (debug pages, emails printed to the terminal)
DJANGO_DEBUG=True

# --- Optional ---
# GEMINI_MODEL=gemini-flash-latest
# QUIZ_QUESTION_COUNT=15
# QUIZ_TIME_LIMIT_SECONDS=900
# QUIZ_GENERATE_LIMIT=10
# DJANGO_TIME_ZONE=Asia/Kolkata

# Email for password reset. Without EMAIL_HOST, emails are printed in the terminal.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=CSE MCQ Portal <you@gmail.com>
